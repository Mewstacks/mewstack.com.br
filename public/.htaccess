# Static site — MewStack (React/Vite, prerendered to HTML at build time)

Options -Indexes
DirectoryIndex index.html

# Prerendered routes live in directories, and mod_dir would answer /rota with a
# 301 to /rota/ before any rewrite runs — an extra hop, and a URL that disagrees
# with the page's own canonical. Turning it off lets the rule below serve the
# file directly. Safe because Options -Indexes already forbids listings.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>
AddDefaultCharset UTF-8

# The FTP deploy action writes its sync state into the docroot; without this it
# is world-readable and lists every file on the server.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- One canonical origin -------------------------------------------------
  # Until now http/https and www/apex all answered 200 with identical HTML:
  # four URLs, one page, no canonical. Both checks are needed because shared
  # hosting terminates TLS at a proxy, where %{HTTPS} stays off.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://mewstack.com.br%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # --- Prerendered routes ---------------------------------------------------
  # One address per page: /rota, never /rota/. Matches what the canonical tag
  # and the sitemap both claim.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # /rota -> /rota/index.html, served in place with a 200.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # No SPA catch-all. Every route is prerendered, so anything left over really
  # is missing and must say 404 — the old `RewriteRule . /index.html` answered
  # 200 for /robots.txt, /sitemap.xml, /favicon.ico and every typo'd URL.
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Verified in production before enabling: http -> https and www -> apex both
  # answer 301, and https serves 200. No includeSubDomains and no preload, so
  # the policy stays scoped to this host and expires on its own.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Vite fingerprints its output, so a hashed file can never go stale. Matched
  # by filename rather than <If ...>, which only exists on Apache 2.4 and would
  # 500 the whole site on an older server.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
  AddOutputFilterByType DEFLATE image/x-icon
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/xml
  AddOutputFilterByType BROTLI_COMPRESS application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  # The hero video is the single heaviest asset and had no cache rule at all.
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/manifest+json .webmanifest
</IfModule>
